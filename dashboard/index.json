{"text": "<style>\n  .ek { font-family: var(--font-anthropic-sans); display: grid; gap: var(--cds-gap-xl); max-width: 72rem; margin-inline: auto; }\n  .ek-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .ek-head p { margin: var(--cds-gap-xs) 0 0; color: var(--color-fg-muted); max-width: 65ch; line-height: 1.5; }\n  .ek-takeaway b { color: var(--color-fg); font-weight: 600; }\n  .ek-tiles { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }\n  .ek-tile, .ek-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n  .ek-tile .lbl { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); letter-spacing: .02em; }\n  .ek-tile .big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; margin-top: var(--cds-gap-xs); }\n  .ek-tile .sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-top: var(--cds-gap-xs); font-variant-numeric: tabular-nums; }\n  .ek-tile.total { border-color: var(--color-fg-muted); }\n  .ek-swatch { display: inline-block; width: .6rem; height: .6rem; border-radius: 2px; margin-right: .35rem; vertical-align: baseline; }\n  .ek-grid { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); }\n  .ek-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .ek-card .note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 var(--cds-gap-md); line-height: 1.45; }\n  .ek-chart { position: relative; min-height: 260px; }\n  .ek-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-sm); }\n  .ek-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; font-variant-numeric: tabular-nums; z-index: 2; }\n  .ek-tip .when { color: var(--cds-text-secondary); margin-bottom: 2px; }\n  .ek-tablewrap { overflow-x: auto; }\n  .ek-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-body); font-variant-numeric: tabular-nums; }\n  .ek-table th { text-align: left; font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); }\n  .ek-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); }\n  .ek-table .num { text-align: right; }\n  .ek-table tr.best td { font-weight: 600; }\n  .ek-pos { color: var(--color-ok); }\n  .ek-neg { color: var(--color-bad); }\n  .ek-foot { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); line-height: 1.5; max-width: 75ch; }\n  .ek-foot ul { margin: var(--cds-gap-xs) 0 0; padding-left: 1.1rem; }\n  .ek-fail { display: flex; align-items: center; justify-content: center; gap: .4rem; min-height: inherit; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .ek-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"ek\">\n  <header class=\"ek-head\">\n    <h1 id=\"title\">Home energy costs</h1>\n    <p class=\"ek-takeaway dash-skeleton\" id=\"takeaway\">\u2014</p>\n  </header>\n\n  <section class=\"ek-tiles\" id=\"tiles\">\n    <div class=\"ek-tile total\">\n      <div class=\"lbl\">Three machines together \u00b7 per year</div>\n      <div class=\"big dash-skeleton\" data-source=\"total\" data-field=\"per_year_eur\" data-row=\"0\">\u2014</div>\n      <div class=\"sub\">\u2248 <span class=\"dash-skeleton\" data-source=\"total\" data-field=\"per_month_eur\" data-row=\"0\">\u2014</span> per month</div>\n    </div>\n    <div class=\"ek-tile\" data-m=\"Washing machine\">\n      <div class=\"lbl\"><span class=\"ek-swatch\"></span>Washing machine \u00b7 per year</div>\n      <div class=\"big dash-skeleton\" data-source=\"machines\" data-field=\"per_year_eur\" data-where=\"machine=Washing machine\">\u2014</div>\n      <div class=\"sub\"><span class=\"dash-skeleton\" data-source=\"machines\" data-field=\"per_month_eur\" data-where=\"machine=Washing machine\">\u2014</span> per month \u00b7 <span data-source=\"machines\" data-field=\"kwh\" data-where=\"machine=Washing machine\">\u2014</span> kWh measured</div>\n    </div>\n    <div class=\"ek-tile\" data-m=\"Dryer\">\n      <div class=\"lbl\"><span class=\"ek-swatch\"></span>Dryer \u00b7 per year</div>\n      <div class=\"big dash-skeleton\" data-source=\"machines\" data-field=\"per_year_eur\" data-where=\"machine=Dryer\">\u2014</div>\n      <div class=\"sub\"><span class=\"dash-skeleton\" data-source=\"machines\" data-field=\"per_month_eur\" data-where=\"machine=Dryer\">\u2014</span> per month \u00b7 <span data-source=\"machines\" data-field=\"kwh\" data-where=\"machine=Dryer\">\u2014</span> kWh measured</div>\n    </div>\n    <div class=\"ek-tile\" data-m=\"Coffee machine\">\n      <div class=\"lbl\"><span class=\"ek-swatch\"></span>Coffee machine \u00b7 per year</div>\n      <div class=\"big dash-skeleton\" data-source=\"machines\" data-field=\"per_year_eur\" data-where=\"machine=Coffee machine\">\u2014</div>\n      <div class=\"sub\"><span class=\"dash-skeleton\" data-source=\"machines\" data-field=\"per_month_eur\" data-where=\"machine=Coffee machine\">\u2014</span> per month \u00b7 <span data-source=\"machines\" data-field=\"kwh\" data-where=\"machine=Coffee machine\">\u2014</span> kWh measured</div>\n    </div>\n  </section>\n\n  <section class=\"ek-grid\">\n    <div class=\"ek-card\" id=\"monthly-card\">\n      <h2>Cost per month</h2>\n      <p class=\"note\">What each machine cost, at the hourly Zonneplan price that applied when it ran. October is the month so far.</p>\n      <div class=\"ek-legend\" id=\"monthly-legend\" data-source=\"monthly\"></div>\n      <div class=\"ek-chart dash-skeleton\" id=\"monthly-chart\" data-source=\"monthly\"></div>\n    </div>\n    <div class=\"ek-card\" id=\"hours-card\">\n      <h2>When electricity is cheap</h2>\n      <p class=\"note\">Average price per kWh by hour of the day, 2026. Midday is cheapest because of solar on the grid; the night is barely cheaper than the evening.</p>\n      <div class=\"ek-chart dash-skeleton\" id=\"hours-chart\" data-source=\"price_by_hour\"></div>\n    </div>\n  </section>\n\n  <section class=\"ek-card\" id=\"timing-card\">\n    <h2>Does running the laundry at night help?</h2>\n    <p class=\"note\">Every wash and dryer run from 2026 replayed at a different time, priced with that day's real hourly rates. Saving is per year compared with how we run them now.</p>\n    <div class=\"ek-tablewrap\">\n      <table class=\"ek-table\" id=\"timing-table\" data-source=\"timing\" data-row-key=\"machine,scenario\">\n        <thead><tr>\n          <th data-field=\"machine\">Machine</th>\n          <th data-field=\"scenario\">When it runs</th>\n          <th class=\"num\" data-field=\"eur_per_kwh\">Price per kWh</th>\n          <th class=\"num\" data-field=\"per_year_eur\">Cost per year</th>\n          <th class=\"num\" data-field=\"saving_per_year_eur\">Saving per year</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n\n  <footer class=\"ek-foot\" id=\"notes\">\n    <strong>About these numbers</strong>\n    <ul>\n      <li>Measured by smart plugs in Home Assistant, multiplied hour by hour by the Zonneplan dynamic tariff (taxes included). Yearly figures are scaled up from the days each plug has been measuring.</li>\n      <li>\"Cheapest hour within 24h\" assumes perfect timing; a delay start that lands between 11:00 and 15:00 gets close to it.</li>\n      <li>Not included: the heat pump and the car. Neither has a plug meter, so their electricity use can't be measured separately.</li>\n    </ul>\n  </footer>\n</div>\n\n<script>\n(() => {\n  const ORDER = ['Washing machine', 'Dryer', 'Coffee machine'];\n  const eur = (v, d = 2) => '\u20ac' + Number(v).toLocaleString('en', { minimumFractionDigits: d, maximumFractionDigits: d });\n  const kwh = v => Number(v).toLocaleString('en', { maximumFractionDigits: 0 });\n  const colorOf = m => dash.colors[ORDER.indexOf(m)];\n\n  dash.calc('total', {\n    inputs: ['machines'],\n    title: 'Three machines per year',\n    description: 'Sum of the yearly and monthly cost of the washing machine, dryer and coffee machine.',\n    fn: (machines) => [{\n      per_year_eur: Math.round(machines.reduce((s, r) => s + Number(r.per_year_eur), 0) * 100) / 100,\n      per_month_eur: Math.round(machines.reduce((s, r) => s + Number(r.per_month_eur), 0) * 100) / 100,\n    }],\n  });\n  dash.calc('laundry_savings', {\n    inputs: ['timing'],\n    title: 'Laundry savings by timing',\n    description: 'Washing machine plus dryer: yearly saving at night versus at the cheapest hour.',\n    fn: (timing) => {\n      const sum = s => Math.round(timing.filter(r => r.scenario === s).reduce((a, r) => a + Number(r.saving_per_year_eur), 0) * 100) / 100;\n      return [{ night_eur: sum('Cheapest night hour'), best_eur: sum('Cheapest hour within 24h') }];\n    },\n  });\n\n  const tip = (box) => {\n    let t = box.querySelector('.ek-tip');\n    if (!t) { t = document.createElement('div'); t.className = 'ek-tip'; t.hidden = true; box.appendChild(t); }\n    return t;\n  };\n  const placeTip = (t, box, x, y) => {\n    t.hidden = false;\n    const w = t.offsetWidth, bw = box.clientWidth;\n    t.style.left = Math.max(0, Math.min(bw - w, x - w / 2)) + 'px';\n    t.style.top = Math.max(0, y - t.offsetHeight - 10) + 'px';\n  };\n  const fail = (el) => { el.classList.remove('dash-skeleton'); el.innerHTML = ''; const f = document.createElement('div'); f.className = 'ek-fail'; f.textContent = 'Failed to load'; el.appendChild(f); };\n  const fill = (sel, text) => document.querySelectorAll(sel).forEach(el => { el.textContent = text; el.classList.remove('dash-skeleton'); });\n\n  function drawTiles() {\n    const m = dash.data('machines'), t = dash.data('total');\n    document.querySelectorAll('.ek-tile[data-m] .ek-swatch').forEach(s => { s.style.background = colorOf(s.closest('.ek-tile').dataset.m); });\n    if (m.status === 'ok') {\n      m.data.forEach(r => {\n        const w = `[data-where=\"machine=${r.machine}\"]`;\n        fill(`[data-source=\"machines\"][data-field=\"per_year_eur\"]${w}`, eur(r.per_year_eur, 0));\n        fill(`[data-source=\"machines\"][data-field=\"per_month_eur\"]${w}`, eur(r.per_month_eur));\n        fill(`[data-source=\"machines\"][data-field=\"kwh\"]${w}`, kwh(r.kwh));\n      });\n    } else if (m.status !== 'loading') fill('[data-source=\"machines\"]', '\u2014');\n    if (t.status === 'ok' && t.data[0]) {\n      fill('[data-source=\"total\"][data-field=\"per_year_eur\"]', eur(t.data[0].per_year_eur, 0));\n      fill('[data-source=\"total\"][data-field=\"per_month_eur\"]', eur(t.data[0].per_month_eur));\n    } else if (t.status !== 'loading') fill('[data-source=\"total\"]', '\u2014');\n  }\n\n  function drawTakeaway() {\n    const el = document.getElementById('takeaway');\n    const t = dash.data('total'), s = dash.data('laundry_savings');\n    if (t.status !== 'ok' || s.status !== 'ok' || !t.data[0] || !s.data[0]) { el.textContent = '\u2014'; return; }\n    el.classList.remove('dash-skeleton');\n    el.textContent = '';\n    const add = (txt, attrs) => {\n      if (!attrs) { el.appendChild(document.createTextNode(txt)); return; }\n      const b = document.createElement('b'); b.textContent = txt;\n      Object.entries(attrs).forEach(([k, v]) => b.setAttribute(k, v)); el.appendChild(b);\n    };\n    add('The washing machine, dryer and coffee machine cost us about ');\n    add(eur(t.data[0].per_year_eur, 0), { 'data-source': 'total', 'data-field': 'per_year_eur', 'data-row': '0' });\n    add(' a year. Running the laundry at night saves only ');\n    add(eur(s.data[0].night_eur), { 'data-source': 'laundry_savings', 'data-field': 'night_eur', 'data-row': '0' });\n    add(' a year; running it around midday saves up to ');\n    add(eur(s.data[0].best_eur, 0), { 'data-source': 'laundry_savings', 'data-field': 'best_eur', 'data-row': '0' });\n    add('.');\n  }\n\n  function drawMonthly() {\n    const box = document.getElementById('monthly-chart'), legend = document.getElementById('monthly-legend');\n    const d = dash.data('monthly');\n    box.querySelectorAll('svg').forEach(n => n.remove());\n    legend.textContent = '';\n    if (d.status === 'error') return fail(box);\n    if (d.status !== 'ok') return;\n    box.classList.remove('dash-skeleton');\n    box.querySelector('.ek-fail')?.remove();\n\n    ORDER.forEach(m => {\n      const s = document.createElement('span');\n      const sw = document.createElement('span'); sw.className = 'ek-swatch'; sw.style.background = colorOf(m);\n      s.appendChild(sw); s.appendChild(document.createTextNode(m)); legend.appendChild(s);\n    });\n\n    const rows = d.data.filter(r => ORDER.includes(r.machine));\n    const months = [...new Set(rows.map(r => r.month))].sort();\n    const partial = new Set(rows.filter(r => r.partial === true || r.partial === 'true').map(r => r.month));\n    const table = months.map(mo => {\n      const o = { month: mo };\n      ORDER.forEach(m => { const r = rows.find(x => x.month === mo && x.machine === m); o[m] = r ? Number(r.cost_eur) : 0; });\n      return o;\n    });\n    const series = d3.stack().keys(ORDER)(table);\n    const W = box.clientWidth || 600, H = 260, m = { t: 8, r: 4, b: 26, l: 40 };\n    const x = d3.scaleBand(months, [m.l, W - m.r]).padding(0.28);\n    const ymax = d3.max(table, o => ORDER.reduce((s, k) => s + o[k], 0)) || 1;\n    const y = d3.scaleLinear([0, ymax * 1.08], [H - m.b, m.t]).nice();\n    const fmtMonth = mo => d3.utcFormat('%b')(new Date(mo + '-01T00:00:00Z'));\n\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img')\n      .attr('aria-label', 'Stacked bars of monthly cost per machine');\n    svg.append('g').selectAll('line').data(y.ticks(4)).join('line')\n      .attr('x1', m.l).attr('x2', W - m.r).attr('y1', v => y(v)).attr('y2', v => y(v))\n      .attr('stroke', 'var(--cds-chart-grid)').attr('stroke-width', 1);\n    svg.append('g').attr('transform', `translate(${m.l - 6},0)`).selectAll('text').data(y.ticks(4)).join('text')\n      .attr('y', v => y(v)).attr('dy', '0.32em').attr('text-anchor', 'end').attr('fill', 'var(--color-fg-muted)')\n      .attr('font-size', 'var(--cds-font-size-caption)').text(v => '\u20ac' + v);\n    const step = x.bandwidth() < 22 ? 2 : 1;\n    svg.append('g').selectAll('text').data(months.filter((_, i) => i % step === 0)).join('text')\n      .attr('x', mo => x(mo) + x.bandwidth() / 2).attr('y', H - 8).attr('text-anchor', 'middle')\n      .attr('fill', 'var(--color-fg-muted)').attr('font-size', 'var(--cds-font-size-caption)')\n      .text(mo => fmtMonth(mo) + (partial.has(mo) ? '*' : ''));\n    const bw = Math.min(32, x.bandwidth());\n    const off = (x.bandwidth() - bw) / 2;\n    series.forEach((s, i) => {\n      svg.append('g').selectAll('rect').data(s).join('rect')\n        .attr('x', p => x(p.data.month) + off).attr('width', bw)\n        .attr('y', p => y(p[1])).attr('height', p => Math.max(0, y(p[0]) - y(p[1])))\n        .attr('rx', i === ORDER.length - 1 ? 3 : 0)\n        .attr('fill', dash.colors[i]).attr('opacity', p => partial.has(p.data.month) ? 0.45 : 1);\n    });\n    const t = tip(box);\n    svg.append('g').selectAll('rect').data(table).join('rect')\n      .attr('x', o => x(o.month)).attr('width', x.bandwidth()).attr('y', m.t).attr('height', H - m.b - m.t)\n      .attr('fill', 'transparent')\n      .on('mousemove', (ev, o) => {\n        t.textContent = '';\n        const w = document.createElement('div'); w.className = 'when';\n        w.textContent = d3.utcFormat('%B %Y')(new Date(o.month + '-01T00:00:00Z')) + (partial.has(o.month) ? ' (so far)' : '');\n        t.appendChild(w);\n        ORDER.slice().reverse().forEach(k => {\n          const line = document.createElement('div');\n          const sw = document.createElement('span'); sw.className = 'ek-swatch'; sw.style.background = colorOf(k);\n          line.appendChild(sw); line.appendChild(document.createTextNode(`${k}  ${eur(o[k])}`)); t.appendChild(line);\n        });\n        const tot = document.createElement('div'); tot.textContent = 'Total  ' + eur(ORDER.reduce((s, k) => s + o[k], 0)); tot.style.marginTop = '2px';\n        t.appendChild(tot);\n        placeTip(t, box, x(o.month) + x.bandwidth() / 2, y(ORDER.reduce((s, k) => s + o[k], 0)));\n      })\n      .on('mouseleave', () => { t.hidden = true; });\n  }\n\n  function drawHours() {\n    const box = document.getElementById('hours-chart');\n    const d = dash.data('price_by_hour');\n    box.querySelectorAll('svg').forEach(n => n.remove());\n    if (d.status === 'error') return fail(box);\n    if (d.status !== 'ok') return;\n    box.classList.remove('dash-skeleton');\n    box.querySelector('.ek-fail')?.remove();\n\n    const rows = d.data.map(r => ({ hour: Number(r.hour), p: Number(r.avg_eur_per_kwh) })).sort((a, b) => a.hour - b.hour);\n    const W = box.clientWidth || 600, H = 260, m = { t: 22, r: 4, b: 26, l: 44 };\n    const x = d3.scaleBand(rows.map(r => r.hour), [m.l, W - m.r]).padding(0.2);\n    const lo = d3.min(rows, r => r.p), hi = d3.max(rows, r => r.p);\n    const y = d3.scaleLinear([0, hi * 1.08], [H - m.b, m.t]).nice();\n    const cheap = new Set(rows.slice().sort((a, b) => a.p - b.p).slice(0, 4).map(r => r.hour));\n    const dear = new Set(rows.slice().sort((a, b) => b.p - a.p).slice(0, 4).map(r => r.hour));\n\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img')\n      .attr('aria-label', 'Average electricity price by hour of day');\n    svg.append('g').selectAll('line').data(y.ticks(4)).join('line')\n      .attr('x1', m.l).attr('x2', W - m.r).attr('y1', v => y(v)).attr('y2', v => y(v))\n      .attr('stroke', 'var(--cds-chart-grid)').attr('stroke-width', 1);\n    svg.append('g').attr('transform', `translate(${m.l - 6},0)`).selectAll('text').data(y.ticks(4)).join('text')\n      .attr('y', v => y(v)).attr('dy', '0.32em').attr('text-anchor', 'end').attr('fill', 'var(--color-fg-muted)')\n      .attr('font-size', 'var(--cds-font-size-caption)').text(v => '\u20ac' + v.toFixed(2));\n    const every = x.bandwidth() < 18 ? 6 : 3;\n    svg.append('g').selectAll('text').data(rows.filter(r => r.hour % every === 0)).join('text')\n      .attr('x', r => x(r.hour) + x.bandwidth() / 2).attr('y', H - 8).attr('text-anchor', 'middle')\n      .attr('fill', 'var(--color-fg-muted)').attr('font-size', 'var(--cds-font-size-caption)')\n      .text(r => String(r.hour).padStart(2, '0') + ':00');\n    svg.append('g').selectAll('rect').data(rows).join('rect')\n      .attr('x', r => x(r.hour)).attr('width', x.bandwidth())\n      .attr('y', r => y(r.p)).attr('height', r => y(0) - y(r.p)).attr('rx', 3)\n      .attr('fill', r => cheap.has(r.hour) ? 'var(--color-ok)' : dear.has(r.hour) ? 'var(--cds-chart-status-critical)' : 'var(--cds-chart-muted)');\n    const label = (set, text) => {\n      const hs = [...set].sort((a, b) => a - b);\n      const cx = (x(hs[0]) + x(hs[hs.length - 1]) + x.bandwidth()) / 2;\n      const top = y(d3.max(rows.filter(r => set.has(r.hour)), r => r.p));\n      svg.append('text').attr('x', Math.max(m.l + 30, Math.min(W - m.r - 30, cx))).attr('y', top - 6).attr('text-anchor', 'middle')\n        .attr('fill', 'var(--color-fg-muted)').attr('font-size', 'var(--cds-font-size-caption)').text(text);\n    };\n    label(cheap, 'cheapest');\n    label(dear, 'most expensive');\n\n    const t = tip(box);\n    svg.append('g').selectAll('rect').data(rows).join('rect')\n      .attr('x', r => x(r.hour) - x.step() * x.paddingInner() / 2).attr('width', x.step()).attr('y', m.t).attr('height', H - m.b - m.t)\n      .attr('fill', 'transparent')\n      .on('mousemove', (ev, r) => {\n        t.textContent = '';\n        const w = document.createElement('div'); w.className = 'when';\n        w.textContent = `${String(r.hour).padStart(2, '0')}:00\u2013${String((r.hour + 1) % 24).padStart(2, '0')}:00`;\n        const v = document.createElement('div'); v.textContent = `\u20ac${r.p.toFixed(3)} per kWh`;\n        t.appendChild(w); t.appendChild(v);\n        placeTip(t, box, x(r.hour) + x.bandwidth() / 2, y(r.p));\n      })\n      .on('mouseleave', () => { t.hidden = true; });\n  }\n\n  function drawTiming() {\n    const tbody = document.querySelector('#timing-table tbody');\n    const d = dash.data('timing');\n    tbody.textContent = '';\n    if (d.status !== 'ok') return;\n    const rows = d.data.slice();\n    const bestByMachine = {};\n    rows.forEach(r => { const v = Number(r.saving_per_year_eur); if (!(r.machine in bestByMachine) || v > bestByMachine[r.machine]) bestByMachine[r.machine] = v; });\n    rows.forEach(r => {\n      const tr = document.createElement('tr');\n      tr.dataset.key = [r.machine, r.scenario].map(encodeURIComponent).join(',');\n      const save = Number(r.saving_per_year_eur);\n      if (save === bestByMachine[r.machine] && save > 0) tr.className = 'best';\n      const cells = [\n        [r.machine, ''], [r.scenario, ''],\n        ['\u20ac' + Number(r.eur_per_kwh).toFixed(3), 'num'],\n        [eur(r.per_year_eur), 'num'],\n        [(save < 0 ? '\u2212' : '') + eur(Math.abs(save)), 'num ' + (save > 1 ? 'ek-pos' : save < 0 ? 'ek-neg' : '')],\n      ];\n      cells.forEach(([txt, cls]) => { const td = document.createElement('td'); td.textContent = txt; if (cls.trim()) td.className = cls.trim(); tr.appendChild(td); });\n      tbody.appendChild(tr);\n    });\n  }\n\n  dash.onData(() => { drawTiles(); drawTakeaway(); drawMonthly(); drawHours(); drawTiming(); });\n})();\n</script>\n"}