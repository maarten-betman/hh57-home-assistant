{
 "id": "slaapkamer_schakelaar",
 "alias": "Slaapkamer: wandschakelaar (ROBB 4 knoppen)",
 "description": "ROBB smarrt ROB_200-022-0 (Friends of Hue, via Hue bridge). Links = kastverlichting (light.slaapkamer), rechts = WiZ RGB lampen. Boven = aan / vasthouden feller, onder = uit / vasthouden dimmen. Bovenknoppen reageren op indrukken (sneller); beide bovenknoppen tegelijk = alles aan.",
 "mode": "queued",
 "max": 10,
 "triggers": [
  {
   "trigger": "state",
   "entity_id": "event.works_with_hue_switch_1_button_1",
   "not_from": "unavailable",
   "id": "kast_up"
  },
  {
   "trigger": "state",
   "entity_id": "event.works_with_hue_switch_1_button_2",
   "not_from": "unavailable",
   "id": "kast_down"
  },
  {
   "trigger": "state",
   "entity_id": "event.works_with_hue_switch_1_button_3",
   "not_from": "unavailable",
   "id": "wiz_up"
  },
  {
   "trigger": "state",
   "entity_id": "event.works_with_hue_switch_1_button_4",
   "not_from": "unavailable",
   "id": "wiz_down"
  }
 ],
 "conditions": [],
 "variables": {
  "event_type": "{{ trigger.to_state.attributes.event_type }}",
  "target_lights": "{{ ['light.wiz_rgbw_tunable_ab2100', 'light.wiz_rgbw_tunable_ab26c2'] if trigger.id.startswith('wiz') else ['light.slaapkamer'] }}",
  "is_up": "{{ trigger.id.endswith('_up') }}",
  "after_hold": "{{ trigger.from_state is not none and trigger.from_state.attributes.event_type in ['repeat', 'long_press'] }}"
 },
 "actions": [
  {
   "condition": "template",
   "value_template": "{{ not (event_type == 'short_release' and after_hold) }}"
  },
  {
   "choose": [
    {
     "conditions": "{{ event_type == 'initial_press' and is_up and trigger.id == 'wiz_up' }}",
     "sequence": [
      {
       "action": "light.turn_on",
       "target": {
        "entity_id": "{{ target_lights }}"
       },
       "data": {
        "color_temp_kelvin": 2470
       }
      }
     ]
    },
    {
     "conditions": "{{ event_type == 'initial_press' and is_up }}",
     "sequence": [
      {
       "action": "light.turn_on",
       "target": {
        "entity_id": "{{ target_lights }}"
       }
      }
     ]
    },
    {
     "conditions": "{{ event_type == 'short_release' and not is_up }}",
     "sequence": [
      {
       "action": "light.turn_off",
       "target": {
        "entity_id": "{{ target_lights }}"
       }
      }
     ]
    },
    {
     "conditions": "{{ event_type in ['long_press', 'repeat'] and is_up }}",
     "sequence": [
      {
       "action": "light.turn_on",
       "target": {
        "entity_id": "{{ target_lights }}"
       },
       "data": {
        "brightness_step_pct": 15
       }
      }
     ]
    },
    {
     "conditions": "{{ event_type in ['long_press', 'repeat'] and not is_up }}",
     "sequence": [
      {
       "action": "light.turn_on",
       "target": {
        "entity_id": "{{ target_lights }}"
       },
       "data": {
        "brightness_step_pct": -15
       }
      }
     ]
    }
   ]
  }
 ]
}